datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum PurchaseMode {
  READY_STOCK     // 100% upfront payment, immediate dispatch
  MADE_TO_ORDER   // >=25% advance to start production, balance before dispatch, 7-day grace
  QUOTE_ONLY      // Custom proposal with locked 30-day quote offer
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT         // Awaiting initial payment (100% for Ready Stock or 25% for MTO)
  CONFIRMED               // Initial payment verified; for MTO, 7-day cancellation grace begins
  IN_PRODUCTION           // MTO: Grace period elapsed, production initiated
  PRODUCTION_COMPLETED    // MTO: Production complete, awaiting 75% balance payment
  AWAITING_DISPATCH       // 100% cumulative payment verified, packaging for courier handoff
  DISPATCHED              // Handed to carrier with tracking number
  DELIVERED               // Verified delivery
  CANCELLED               // Cancelled before production start / statutory right
  REFUNDED                // Refund processed per locked financial policy
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentType {
  FULL_PAYMENT            // Ready Stock 100% payment
  ADVANCE_25              // Made to Order minimum 25% production advance
  BALANCE_75              // Made to Order 75% pre-dispatch balance
  QUOTE_ADVANCE           // Quote Only 25% acceptance advance
  QUOTE_BALANCE           // Quote Only 75% completion balance
  REFUND                  // Outgoing statutory or approved refund
}

enum QuoteStatus {
  DRAFT
  ISSUED                  // Active 30-calendar-day offer clock ticking
  ACCEPTED                // Customer accepted exact version & paid 25% advance
  EXPIRED                 // 30 calendar days elapsed without verified acceptance
  SUPERSEDED              // Replaced by a revised version (does not reset original clock)
  REJECTED                // Declined by customer or staff
}

enum StaffRole {
  SUPER_ADMIN
  COMMERCE_ADMIN
  PRODUCTION_STAFF
  SUPPORT_STAFF
}

enum StockMovementType {
  INITIAL_STOCK
  RESTOCK
  PURCHASE_RESERVATION
  RESERVATION_EXPIRED
  ORDER_FULFILLED
  RETURN_RESTOCK
  MANUAL_ADJUSTMENT
}

// -------------------------------------------------------------
// IDENTITY & RBAC
// -------------------------------------------------------------

model User {
  id               String                   @id @default(cuid())
  email            String                   @unique
  name             String?
  phone            String?
  passwordHash     String?
  emailVerifiedAt  DateTime?
  gstin             String?
  practiceOrStudio  String?
  mfaEnabled        Boolean                  @default(false)
  mfaMethod         String?                  // "EMAIL" | "TOTP"
  totpSecret        String?
  totpPendingSecret String?
  role              StaffRole?               // Null for regular customers, populated for staff
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  addresses        CustomerAddress[]
  orders           Order[]
  auditLogs        AuditLog[]
  sessions         CustomerSession[]
  emailTokens      EmailVerificationToken[]

  @@index([email])
}

model CustomerSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  purpose    String    // "VERIFY_EMAIL", "LOGIN_OTP", "PASSWORD_RESET", "MFA_EMAIL", "MFA_EMAIL_SETUP", "MFA_CHALLENGE"
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
}

model CustomerAddress {
  id            String          @id @default(cuid())
  userId        String?
  guestEmail    String?
  label         String          @default("Delivery Location")
  fullName      String
  phone         String
  addressLine1  String
  addressLine2  String?
  city          String
  state         String
  pincode       String          // 6-digit Indian PIN code
  isDefault     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt @default(now())

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders        Order[]

  @@index([pincode])
  @@index([userId])
}

// -------------------------------------------------------------
// CATALOGUE & MERCHANDISING
// -------------------------------------------------------------

model Category {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  sortOrder     Int             @default(0)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  products      Product[]
}

model Collection {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  isFeatured    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  products      ProductCollection[]
}

model Product {
  id                    String              @id @default(cuid())
  slug                  String              @unique
  sku                   String              @unique
  title                 String
  shortDescription      String
  fullDescription       String
  materialDescription   String
  dimensions            String              // Human-readable (e.g. "420mm dia x 35mm depth")

  // Taxonomy tags (TAV-02 / taxonomy.md)
  subcategory           String?             // e.g. "Clocks", "Mirrors", "Desk Organisation"
  productType           String?             // e.g. "Wall Clocks", "Wall Mirrors"

  // Physical specifications for volumetric distance-band shipping
  weightGrams           Int                 @default(1000)
  lengthMm              Int                 @default(100)
  widthMm               Int                 @default(100)
  heightMm              Int                 @default(100)

  // Primary purchase discipline
  primaryMode           PurchaseMode        @default(READY_STOCK)

  // Exactly two-component pricing baseline (tax-inclusive)
  taxInclusivePrice     Decimal             @db.Decimal(10, 2)
  gstRate               Decimal             @default(0.18) @db.Decimal(4, 2) // Default 18% GST

  // Return policy (TAV-10: non-returnable by default)
  isReturnable          Boolean             @default(false)
  returnWindowDays      Int?                // Null if non-returnable; integer if returnable

  isPublished           Boolean             @default(true)
  categoryId            String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  category              Category            @relation(fields: [categoryId], references: [id])
  variants              ProductVariant[]
  images                ProductImage[]
  collections           ProductCollection[]
  orderItems            OrderItem[]
  deliveryOverrides     ProductDeliveryOverride[]

  @@index([slug])
  @@index([categoryId])
  @@index([primaryMode])
}

model ProductCollection {
  productId     String
  collectionId  String

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection    Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductVariant {
  id                    String              @id @default(cuid())
  productId             String
  sku                   String              @unique
  title                 String              // e.g. "Smoked Oak / Brushed Brass"
  materialFinish        String?
  color                 String?
  imageUrl              String?             // Variant-specific hero/thumbnail image
  imageUrls             String?             // JSON array of variant gallery URLs (e.g. ["/uploads/..."])
  taxInclusivePrice     Decimal             @db.Decimal(10, 2)

  // Variant-specific overrides (nullable, falls back to Product master)
  description           String?             // Variant-specific description override
  dimensions            String?             // Variant-specific dimensions override (e.g. "400mm Dia x 45mm D")
  weightGrams           Int?                // Variant-specific weight override in grams
  lengthMm              Int?
  widthMm               Int?
  heightMm              Int?

  isPublished           Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  product               Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryLedger       InventoryLedger?
  orderItems            OrderItem[]

  @@index([productId])
  @@index([sku])
}

model ProductImage {
  id            String          @id @default(cuid())
  productId     String
  url           String
  altText       String?
  sortOrder     Int             @default(0)
  isPrimary     Boolean         @default(false)

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// -------------------------------------------------------------
// INVENTORY & STOCK LEDGER (TAV-05: Concurrency Safety)
// -------------------------------------------------------------

model InventoryLedger {
  id                  String              @id @default(cuid())
  variantId           String              @unique
  availableStock      Int                 @default(0)
  reservedStock       Int                 @default(0)
  lowStockThreshold   Int                 @default(2)
  updatedAt           DateTime            @updatedAt

  variant             ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements           StockMovement[]

  @@index([variantId])
}

model StockMovement {
  id                  String              @id @default(cuid())
  inventoryLedgerId   String
  type                StockMovementType
  quantity            Int
  referenceId         String?             // Order ID or Reservation token
  notes               String?
  createdAt           DateTime            @default(now())

  ledger              InventoryLedger     @relation(fields: [inventoryLedgerId], references: [id], onDelete: Cascade)

  @@index([inventoryLedgerId])
}

// -------------------------------------------------------------
// DISTANCE-BAND SHIPPING (TAV-03 & TAV-09: Zones A, B, C, D)
// -------------------------------------------------------------

model ShippingZone {
  id                  String              @id @default(cuid())
  code                String              @unique // "ZONE_A", "ZONE_B", "ZONE_C", "ZONE_D", "ZONE_E"
  name                String              // e.g. "Zone A (Delhi NCR / Local)"
  description         String
  baseWeightGrams     Int                 @default(2000) // First 2 kg
  baseRate            Decimal             @db.Decimal(10, 2)
  perAdditionalKgRate Decimal             @db.Decimal(10, 2)
  estimatedDaysMin    Int                 @default(2)
  estimatedDaysMax    Int                 @default(5)

  pincodeRanges       PincodeRange[]
}

model PincodeRange {
  id                  String              @id @default(cuid())
  shippingZoneId      String
  stateName           String
  cityLabel           String?             // Human-readable city/locality label
  pincodePrefix       String              @unique // e.g. "11", "110", or exact 6 digits "110062"
  isServiceable       Boolean             @default(true)
  coverageMode        String              @default("STRICT_WHITELIST") // "STRICT_WHITELIST" | "ALLOW_ALL_IN_PREFIX"
  unserviceableReason String?             // Customer-facing notice if suspended
  source              String              @default("REGION_PREFIX") // "REGION_PREFIX", "URBAN_884", "ADMIN_OVERRIDE"
  updatedAt           DateTime            @updatedAt @default(now())

  shippingZone        ShippingZone        @relation(fields: [shippingZoneId], references: [id], onDelete: Cascade)

  @@index([pincodePrefix])
  @@index([shippingZoneId])
}

model DeliveryRateRule {
  id                  String              @id @default(cuid())
  tierCode            String              // "MINI", "SMALL", "MEDIUM", "LARGE", "HEAVY_CRATED"
  tierLabel           String              // e.g. "Medium Fragile (<= 6 kg)"
  maxWeightGrams      Int                 // 500, 2000, 6000, 22000, 55000
  carrierTier         String              // "DELHIVERY_AIR", "BLUEDART_SURFACE", "SAFEEXPRESS_PALLET"
  carrierName         String              // "Blue Dart Surfaceline", etc.
  shippingZoneCode    String              // "ZONE_A".."ZONE_E"
  feeSlabRupees       Int                 // One of the 12 approved slabs: 0..7500
  updatedAt           DateTime            @updatedAt

  @@unique([tierCode, shippingZoneCode])
  @@index([shippingZoneCode])
}

model ProductDeliveryOverride {
  id                  String              @id @default(cuid())
  productId           String
  shippingZoneCode    String              // "ZONE_A".."ZONE_E"
  feeSlabRupees       Int                 // One of the 12 approved slabs: 0..7500
  updatedAt           DateTime            @updatedAt

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, shippingZoneCode])
  @@index([productId])
}

// -------------------------------------------------------------
// ORDERS & FINANCIAL LEDGER (TAV-03, TAV-04, TAV-06)
// -------------------------------------------------------------

model Order {
  id                    String              @id @default(cuid())
  orderNumber           String              @unique // Format: TAV-YYYYMMDD-XXXX
  userId                String?
  customerEmail         String
  customerPhone         String
  shippingAddressId     String
  purchaseMode          PurchaseMode

  // Exactly two customer-facing price components (TAV-03)
  itemsSubtotal         Decimal             @db.Decimal(10, 2) // Component 1: Tax-inclusive items total
  shippingCharge        Decimal             @db.Decimal(10, 2) // Component 2: Combined distance-band delivery charge
  totalAmount           Decimal             @db.Decimal(10, 2) // itemsSubtotal + shippingCharge

  // Milestone advance tracking (TAV-06)
  requiredAdvanceAmount Decimal             @db.Decimal(10, 2) // >=25% for MTO; 100% for Ready Stock
  amountPaid            Decimal             @default(0.00) @db.Decimal(10, 2)
  balanceAmount         Decimal             @db.Decimal(10, 2)

  status                OrderStatus         @default(PENDING_PAYMENT)

  // Milestones & audit timestamps
  confirmedAt           DateTime?           // Triggers 7-day grace period for MTO
  productionStartedAt   DateTime?           // Locks production; ends pre-production cancellation grace
  productionCompletedAt DateTime?
  dispatchedAt          DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?

  // Shipping & Tracking
  carrierName           String?
  trackingNumber        String?

  // Workshop QC Inspection & Customer Transparency
  qcNotes               String?
  qcImages              String?             // JSON array of image URLs (e.g. ["/images/qc/qc-1.jpg"])

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user                  User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingAddress       CustomerAddress     @relation(fields: [shippingAddressId], references: [id])
  items                 OrderItem[]
  payments              Payment[]

  @@index([orderNumber])
  @@index([customerEmail])
  @@index([status])
  @@index([purchaseMode])
}

model OrderItem {
  id                    String              @id @default(cuid())
  orderId               String
  productId             String
  variantId             String?
  quantity              Int                 @default(1)
  unitPrice             Decimal             @db.Decimal(10, 2) // Tax-inclusive snapshot
  subtotal              Decimal             @db.Decimal(10, 2)

  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product             @relation(fields: [productId], references: [id])
  variant               ProductVariant?     @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id                    String              @id @default(cuid())
  orderId               String
  paymentType           PaymentType
  amount                Decimal             @db.Decimal(10, 2)
  status                PaymentStatus       @default(PENDING)
  gateway               String              @default("PHONEPE") // "PHONEPE" or "MANUAL_BANK"
  gatewayTransactionId  String?
  gatewayOrderRef       String?
  verifiedAt            DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())

  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayTransactionId])
  @@index([status])
}

// -------------------------------------------------------------
// QUOTATIONS (TAV-07: Quote Only 30-Day Offer Governance)
// -------------------------------------------------------------

model QuoteProposal {
  id                    String              @id @default(cuid())
  quoteNumber           String              @unique // Format: QTE-YYYYMMDD-XXXX
  inquiryId             String?             // Optional link to originating BulkInquiry
  customerName          String
  customerEmail         String
  customerPhone         String
  deliveryPincode       String
  projectSpecifications String

  status                QuoteStatus         @default(DRAFT)
  expiresAt             DateTime            // Locked 30 calendar days from initial issuance
  acceptedAt            DateTime?
  linkedOrderId         String?             // Links to Order when 25% advance verified

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  versions              QuoteVersion[]

  @@index([quoteNumber])
  @@index([customerEmail])
  @@index([inquiryId])
  @@index([status])
}

model QuoteVersion {
  id                    String              @id @default(cuid())
  quoteProposalId       String
  versionNumber         Int                 @default(1)
  specifications        String
  lineItemsJson         String?             // Structured QuoteLineItem[] JSON
  deliveryCharge        Decimal             @default(0.00) @db.Decimal(10, 2)
  quotedAmount          Decimal             @db.Decimal(10, 2)
  advanceRequired       Decimal             @db.Decimal(10, 2) // 25% of quotedAmount
  estimatedLeadDays     Int                 @default(28)
  validUntil            DateTime
  createdAt             DateTime            @default(now())

  proposal              QuoteProposal       @relation(fields: [quoteProposalId], references: [id], onDelete: Cascade)

  @@unique([quoteProposalId, versionNumber])
  @@index([quoteProposalId])
}

// -------------------------------------------------------------
// IMMUTABLE AUDIT LOG (TAV-12: Staff Governance)
// -------------------------------------------------------------

model AuditLog {
  id            String          @id @default(cuid())
  userId        String?
  action        String          // e.g. "START_PRODUCTION", "OVERRIDE_REFUND", "PUBLISH_CATALOGUE"
  entityType    String          // "Order", "Product", "Quote", "Inventory"
  entityId      String
  payloadJson   String?         // Serialized state snapshot
  ipAddress     String?
  createdAt     DateTime        @default(now())

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------------
// SUPPORT TICKETS & CUSTOMER DESK
// -------------------------------------------------------------

model SupportTicket {
  id            String          @id @default(cuid())
  ticketNumber  String          @unique // e.g. TCK-2026-1001
  orderNumber   String?
  customerName  String
  email         String
  phone         String
  subject       String
  category      String          // ORDER_INQUIRY, SPEC_ALTERATION, DELIVERY_SCHEDULE, DAMAGE_REPORT, CANCELLATION
  priority      String          @default("NORMAL") // NORMAL, HIGH, URGENT
  status        String          @default("OPEN")   // OPEN, IN_PROGRESS, RESOLVED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages      TicketMessage[]

  @@index([ticketNumber])
  @@index([email])
  @@index([orderNumber])
  @@index([status])
}

model TicketMessage {
  id            String          @id @default(cuid())
  ticketId      String
  sender        String          // CUSTOMER, STAFF
  authorName    String
  text          String
  createdAt     DateTime        @default(now())

  ticket        SupportTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// -------------------------------------------------------------
// COMMERCIAL BULK INQUIRIES & ARCHITECTURAL SPECS
// -------------------------------------------------------------

model BulkInquiry {
  id                  String          @id @default(cuid())
  inquiryNumber       String          @unique // e.g. INQ-2026-1001
  clientName          String
  practiceOrStudio    String?
  email               String
  phone               String
  destinationCity     String
  destinationPincode  String
  requestedEditions   String
  quantityUnits       Int             @default(10)
  specifications      String
  lineItemsJson       String?         // Structured QuoteLineItem[] transferred from cart
  status              String          @default("NEW") // NEW, IN_REVIEW, QUOTE_ISSUED, CLOSED
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([inquiryNumber])
  @@index([email])
  @@index([status])
}

// -------------------------------------------------------------
// SYSTEM SETTINGS & STUDIO GOVERNANCE (Hiatus & Maintenance)
// -------------------------------------------------------------

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "MAINTENANCE_MODE", "STUDIO_HIATUS", "ANNOUNCEMENT_BANNER"
  value       String   // e.g. "false", "true", "Studio craft operations paused..."
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
}


